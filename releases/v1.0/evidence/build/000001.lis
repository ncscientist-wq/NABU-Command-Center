     1                          ; For ROM compilations copy the data section up into RAM
     2                          
     3                          IF ( __crt_model = 1 )
     4                              ; Just copy the DATA section
     5                              EXTERN  __ROMABLE_END_tail
     6                              EXTERN  __DATA_head
     7                              EXTERN  __DATA_END_tail
     8                              ld      hl,__ROMABLE_END_tail
     9                              ld      de,__DATA_head
    10                              ld      bc,__DATA_END_tail - __DATA_head
    11                            IF __CPU_INTEL__
    12                              EXTERN  asm_memcpy
    13                              call    asm_memcpy
    14                            ELSE
    15                              ldir
    16                            ENDIF
    17                          ELIF ( __crt_model >= 2 )
    18                              EXTERN  __ROMABLE_END_tail
    19                              EXTERN  __DATA_head
    20                              ld      hl,__ROMABLE_END_tail
    21                              ld      de,__DATA_head
    22                            IF ( __crt_model = 2)
    23                              EXTERN  asm_dzx7_standard
    24                              call    asm_dzx7_standard
    25                            ELIF ( __crt_model = 3)
    26                              EXTERN  asm_dzx0_standard
    27                              call    asm_dzx0_standard
    28                            ENDIF
    29                          ENDIF

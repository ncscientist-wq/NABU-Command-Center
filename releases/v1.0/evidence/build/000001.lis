     1                          
     2                          ; Heap setup. We have a few ways to setup the heap
     3                          ;
     4                          ; 1. -pragma-define:CLIB_MALLOC_HEAP_SIZE - creates a heap in BSS
     5                          ; 2. -pragma-define:CRT_STACK_SIZE - leaves x for stack, rest is heap
     6                          ; 3. -DAMALLOC etc - divides up the space. Last address either programmatic or defined by
     7                          ; CRT_MAX_HEAP_ADDRESS
     8                          ; 4. Some ports call in with fixed addresses to use
     9                          ;
    10                          ; For 2 and 3, heap runs from either _BSS_TAIL or CRT_HEAP_ADDRESS
    11                          ;
    12                          ; Note: This code must be called after crt0_init for two reasons:
    13                          ; 1. The heap pointer is within bss (so would get wiped)
    14                          ; 2. Some targets have a himem blob sitting after bss on load
    15                          
    16                          
    17                          MACRO MALLSUB_HLDE
    18                            IF __CPU_INTEL__ || __CPU_GBZ80__
    19                              ld      a,l
    20                              sub     e
    21                              ld      l,a
    22                              ld      a,h
    23                              sbc     d
    24                              ld      h,a
    25                            ELSE
    26                              sbc     hl,de
    27                            ENDIF
    28                          ENDM
    29                          
    30                          
    31                          IF __clib_malloc_heap_size > 0
    32                              ;; The heap is in BSS section already, just need to register it
    33                              ld      bc,__autoheap
    34                              ld      hl,__clib_malloc_heap_size
    35                              push    bc      ; main address for malloc area
    36                              push    hl      ; area size
    37                              EXTERN  sbrk_callee
    38                              call    sbrk_callee
    39                          ELIF __crt_stack_size > 0
    40                              ;; Support the newlib model where we set how much stack we want and then the rest is heap
    41                              ld      hl,sp
    42                              ld      de,__crt_stack_size
    43                              and     a
    44                              MALLSUB_HLDE
    45                            IFDEF CRT_HEAP_ADDRESS
    46                              ld      de,CRT_HEAP_ADDRESS
    47                            ELSE
    48                              EXTERN  __BSS_END_tail
    49                              ld      de,__BSS_END_tail
    50                            ENDIF
    51                              and     a
    52                              MALLSUB_HLDE
    53                              push    de      ; main address for malloc area
    54                              push    hl      ; area size
    55                              EXTERN  sbrk_callee
    56                              call    sbrk_callee
    57                          ELIF DEFINED_CRT_HEAP_AMALLOC
    58                            ;; -DAMALLOC handling
    59                            IF CRT_MAX_HEAP_ADDRESS
    60                              ld      hl,CRT_MAX_HEAP_ADDRESS
    61                              defc __crt_skip_heapsize_calcs = 1
    62                            ELIFNDEF CRT_MAX_HEAP_ADDRESS_hl
    63                              ld      hl,sp
    64                            ELSE
    65                              ;hl holds top address
    66                              defc __crt_skip_heapsize_calcs = 1
    67                            ENDIF
    68                              ; HL must hold SP or the end of free memory
    69                            IFDEF CRT_HEAP_ADDRESS
    70                              ld      bc,CRT_HEAP_ADDRESS
    71                            ELSE
    72                              EXTERN  __BSS_END_tail
    73                              ld      bc,__BSS_END_tail
    74                            ENDIF
    75                          
    76                          ; hl = sp/end of heap
    77                          ; bc = start of heap
    78                          
    79                            IF __CPU_8085__
    80                              sub     hl,bc   ; hl = total free memory
    81                            ELIF __CPU_8080__ || __CPU_GBZ80__
    82                              ld      a,l
    83                              sub     c
    84                              ld      l,a
    85                              ld      a,h
    86                              sbc     b
    87                              ld      h,a
    88                            ELSE
    89                              sbc     hl,bc   ; hl = total free memory
    90                            ENDIF
    91                          
    92                          
    93                            IFNDEF __crt_skip_heapsize_calcs
    94                              ld      de,hl
    95                          ; AMALLOC initialisation
    96                          ; First of all find a 25% of the free memory
    97                             IF __CPU_8085__
    98                              sra     hl
    99                              sra     hl
   100                              ld      a,$3F
   101                              and     h
   102                              ld      h,a
   103                              ex      de,hl
   104                             ELIF __CPU_8080__ || __CPU_GBZ80__
   105                              and     a
   106                              ld      a,d
   107                              rra
   108                              ld      d,a
   109                              ld      a,e
   110                              rra
   111                              ld      e,a
   112                              and     a
   113                              ld      a,d
   114                              rra
   115                              ld      d,a
   116                              ld      a,e
   117                              rra
   118                              ld      e,a
   119                             ELSE
   120                              srl     d
   121                              rr      e
   122                              srl     d
   123                              rr      e
   124                             ENDIF
   125                          
   126                          
   127                             ; Reduce to heap size to 75% of available memory
   128                             MALLSUB_HLDE
   129                             ; Reduce to 50% if needed
   130                             IF CRT_HEAP_AMALLOC & 2
   131                             MALLSUB_HLDE
   132                             ENDIF
   133                            ; Reduce to 25% if needed
   134                             IF CRT_HEAP_AMALLOC & 4
   135                             MALLSUB_HLDE
   136                             ENDIF
   137                            ENDIF
   138                          
   139                              push    bc      ; main address for malloc area
   140                              push    hl      ; area size
   141                              EXTERN  sbrk_callee
   142                              call    sbrk_callee
   143                          
   144                          ENDIF

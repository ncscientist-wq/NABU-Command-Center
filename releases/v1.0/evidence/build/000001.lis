     2                          IF CRT_INITIALIZE_BSS = 1
     3                              EXTERN  __BSS_head
     4                              EXTERN  __BSS_END_tail
     5  0000  af                    xor     a
     6  0001  210000                ld      hl,__BSS_head
     7  0004  01ffff                ld      bc,__BSS_END_tail - __BSS_head - 1
     8                            IF !__CPU_INTEL__ && !__CPU_GBZ80__
     9  0007  110100                ld      de,__BSS_head + 1
    10  000a  77                    ld      (hl),a
    11  000b  edb0                  ldir
    12                            ELSE
    13                              inc     b
    14                              inc     c
    15                          init_8080:
    16                              ld      (hl+),a
    17                              dec     c
    18                              jr      NZ,init_8080
    19                              dec     b
    20                              jr      NZ,init_8080
    21                            ENDIF
    22                          ENDIF

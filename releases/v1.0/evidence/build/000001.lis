   326                          
   327                              ; Macro to allow setting up a FILE * as pointing via a trampoline
   328                              ;
   329                              ; n = FILE number (0 = stdin, 1 = stdout, 2 = stderr)
   330                              ; trampoline = address of trampoline function
   331                              MACRO setup_fp  n, trampoline
   332                                  ld      hl,+(__sgoioblk + 2 +  (n * 10))
   333                                  ld      (hl),33         ;_IOEXTRA|_IOUSE (stdio.h)
   334                                  inc     hl              ;ungetc
   335                                  inc     hl
   336                                  ld      (hl), +( trampoline % 256)
   337                                  inc     hl
   338                                  ld      (hl), +( trampoline / 256)
   339                              ENDM
   340                          
   341                              ; Macro to allow setting up a static FILE
   342                              MACRO setup_static_fp  device, trampoline
   343                                  SECTION bss_crt
   344                                  PUBLIC  device
   345                          device:   defs    10
   346                          
   347                                  SECTION code_crt_init
   348                                  ld      hl, device + 2
   349                                  ld      (hl),33         ;_IOEXTRA|_IOUSE (stdio.h)
   350                                  inc     hl              ;ungetc
   351                                  inc     hl
   352                                  ld      (hl), +( trampoline % 256)
   353                                  inc     hl
   354                                  ld      (hl), +( trampoline / 256)
   355                              ENDM
